{
  "name": "@enbox/react",
  "version": "0.0.1",
  "description": "React bindings for Enbox wallet connections and typed live records",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enboxorg/enbox-react.git"
  },
  "sideEffects": false,
  "files": ["dist", "src", "LICENSE", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "bun run build && tsc --noEmit && tsc -p type-tests/tsconfig.json && tsc -p tsconfig.tools.json && tsc --noEmit -p examples/notes/tsconfig.json",
    "test": "vitest run",
    "test:package": "bun run build && node --test --test-isolation=none tests/package/*.test.mjs",
    "test:browser": "bun run build && bun run example:build && playwright test",
    "check": "bun run typecheck && bun run test && node --test --test-isolation=none tests/package/*.test.mjs",
    "example:dev": "vite --config examples/notes/vite.config.ts",
    "example:build": "vite build --config examples/notes/vite.config.ts",
    "example:preview": "vite preview --config examples/notes/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "@enbox/browser": "0.3.79",
    "react": "19.3.0"
  },
  "dependencies": {
    "use-sync-external-store": "1.7.0"
  },
  "devDependencies": {
    "@enbox/api": "0.6.87",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/use-sync-external-store": "1.5.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "0.21.2",
    "vitest": "4.1.11",
    "workbox-precaching": "7.4.0",
    "workbox-routing": "7.4.0"
  }
}
