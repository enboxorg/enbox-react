{
  "name": "@enbox/react",
  "version": "0.0.10",
  "description": "React bindings for Enbox application stores and wallet connections",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enboxorg/enbox-react.git"
  },
  "sideEffects": false,
  "files": ["dist", "src", "LICENSE", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "bun run build && tsc --noEmit && tsc -p type-tests/tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:package": "bun run build && node --test --test-isolation=none tests/package/*.test.mjs",
    "test:browser": "bun run build && node scripts/test-starter.mjs",
    "test:generator": "node --test packages/create-dapp/tests/*.test.mjs",
    "audit": "bun audit",
    "check": "bun run audit && bun run typecheck && bun run test && node --test --test-isolation=none tests/package/*.test.mjs && bun run test:generator",
    "starter:dev": "bun run build && node scripts/dev-starter.mjs",
    "prepack": "bun run build",
    "test:react18": "bun run build && node scripts/test-react18.mjs"
  },
  "peerDependencies": {
    "@enbox/browser": "0.3.85",
    "react": "18.3.1 || 19.3.0"
  },
  "dependencies": {
    "use-sync-external-store": "1.7.0"
  },
  "devDependencies": {
    "@enbox/api": "0.6.91",
    "@enbox/browser": "0.3.85",
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/use-sync-external-store": "1.5.0",
    "jsdom": "26.1.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
