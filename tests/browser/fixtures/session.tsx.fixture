import type { ConnectionSnapshot, ConnectionStore, Enbox, ExpandableRecordView, RecordViewState } from '@enbox/browser';
import { ConnectDeniedError } from '@enbox/browser';
import { createApplication } from '@enbox/browser';
import { EnboxProvider } from '@enbox/react';
import { StrictMode } from 'react';
import { createRoot } from 'react-dom/client';

import { App } from '../src/app/App.js';
import { applicationOptions } from '../src/app/application.js';
import type { Project, Task } from '../src/features/tasks/protocol.js';
import '../src/style.css';

// Control only the native boundary. The starter uses the actual React SDK.
const parameters = new URLSearchParams(location.search);
type Row = { record: { id: string; contextId: string }; value: Project | Task };
type AgentSession = NonNullable<ConnectionSnapshot['session']>;
type Entry = Row & { path: string; within: string | undefined };
const entries = new Map<string, Entry>();
const views = new Set<FixtureView>();
let sequence = 0;
let failRead = parameters.has('read-error');
let failSelectedRead = parameters.has('selected-read-error');
let taskObservations = 0;
let failWrite = parameters.has('write-error');
let finishSave: (() => void) | undefined;
let needsRepair = parameters.has('repair');

function create(path: string, data: Row['value'], within?: string): Row['record'] {
  const id = `record${++sequence}`;
  const record = { id, contextId: within === undefined ? id : `${within}/${id}` };
  entries.set(id, { path, within, record, value: data });
  for (const view of views) view.publish();
  return record;
}
if (parameters.has('seed')) {
  const project = create('project', { name: 'First project' });
  create('project/task', { title: 'First task', completed: false }, project.contextId);
  if (parameters.has('full-project')) {
    for (let index = 2; index <= 20; index++) {
      create('project/task', { title: `Task ${index}`, completed: false }, project.contextId);
    }
  }
}

class FixtureView implements ExpandableRecordView<Row> {
  private state: Extract<RecordViewState<Row>, { status: 'ready' }>;
  private readonly listeners = new Set<(state: RecordViewState<Row>) => void>();
  private limit: number;
  public constructor(private readonly path: string, private readonly within: string | undefined,
    private readonly recordId: string | undefined, private readonly pageSize: number, private readonly descending: boolean) {
    this.limit = pageSize;
    this.state = this.snapshot();
  }
  private rows(): Row[] {
    const rows = [...entries.values()].filter((entry) => entry.path === this.path && entry.within === this.within
      && (this.recordId === undefined || entry.record.id === this.recordId));
    return this.descending ? rows.reverse() : rows;
  }
  private snapshot(): typeof this.state {
    const rows = this.rows();
    return { status: 'ready', records: rows.slice(0, this.limit), hasMore: rows.length > this.limit, current: true };
  }
  public async loadMore(): Promise<void> { this.limit += this.pageSize; this.publish(); }
  public getSnapshot(): RecordViewState<Row> { return this.state; }
  public subscribe(listener: (state: RecordViewState<Row>) => void): () => void {
    this.listeners.add(listener);
    return () => { this.listeners.delete(listener); };
  }
  public async ready(): Promise<typeof this.state> { return this.state; }
  public async refresh(): Promise<typeof this.state> { this.publish(); return this.state; }
  public async close(): Promise<void> { this.listeners.clear(); views.delete(this); }
  public publish(): void {
    this.state = this.snapshot();
    for (const listener of this.listeners) listener(this.state);
  }
}

async function beforeWrite(): Promise<void> {
  if (parameters.has('defer-save')) await new Promise<void>((resolve) => { finishSave = resolve; });
  if (failWrite) { failWrite = false; throw new Error('Fixture save failed.'); }
}

const enbox = {
  dwn: { records: {
    query: async () => ({ status: { code: 200 }, records: parameters.has('missing-profile') ? [] : [{
      data: {
        json: async () => ({ displayName: 'Alice Example', bio: 'A profile supplied by the browser fixture.' }),
        blob: async () => new Blob(),
      },
    }] }),
    read: async () => ({ status: { code: 404 } }),
  } },
  using: () => ({ records: {
    observe: async (path: string, options: { within?: string; filter?: { recordId?: string }; pagination: { limit: number }; dateSort?: string }) => {
      if (failRead) { failRead = false; throw new Error('Fixture read failed.'); }
      if (path === 'project/task' && options.filter?.recordId !== undefined && failSelectedRead) {
        failSelectedRead = false;
        throw new Error('Fixture selected read failed.');
      }
      if (path === 'project/task') taskObservations += 1;
      const view = new FixtureView(path, options.within, options.filter?.recordId, options.pagination.limit, options.dateSort === 'createdDescending');
      views.add(view);
      return view;
    },
    create: async (path: string, request: { data: Row['value']; parentContextId?: string }) => {
      await beforeWrite();
      return create(path, request.data, request.parentContextId);
    },
    read: async (_path: string, id: string) => entries.get(id)?.record,
    patch: async (_path: string, id: string, patch: Partial<Task>) => {
      await beforeWrite();
      const entry = entries.get(id)!;
      entries.set(id, { ...entry, value: { ...entry.value, ...patch } });
      for (const view of views) view.publish();
      return entry.record;
    },
    delete: async (_path: string, request: { recordId: string }) => {
      await beforeWrite();
      entries.delete(request.recordId);
      for (const view of views) view.publish();
    },
  } }),
} as unknown as Enbox;

let snapshot: ConnectionSnapshot = { phase: 'initializing' };
const listeners = new Set<(state: ConnectionSnapshot) => void>();
let sessionLifetime: AbortController | undefined;
function publish(next: ConnectionSnapshot): ConnectionSnapshot {
  snapshot = Object.freeze(next);
  for (const listener of listeners) listener(snapshot);
  return snapshot;
}

const client = {
  getSnapshot: () => snapshot,
  subscribe: (listener: (state: ConnectionSnapshot) => void) => {
    listeners.add(listener);
    return () => { listeners.delete(listener); };
  },
  initialize: async () => snapshot.phase === 'initializing' ? publish({ phase: 'disconnected' }) : snapshot,
  connect: async () => {
    if (parameters.has('deny')) return publish({ phase: 'disconnected', error: new ConnectDeniedError() });
    sessionLifetime = new AbortController();
    const did = 'did:example:alice';
    const session: AgentSession = {
      agent: {} as AgentSession['agent'], did, signal: sessionLifetime.signal,
      identity: { didUri: did, name: 'Alice' },
    };
    const walletReapprovalRequired = needsRepair;
    needsRepair = false;
    return publish({ phase: 'connected', enbox, session, walletReapprovalRequired });
  },
  disconnect: async () => { sessionLifetime?.abort(); return publish({ phase: 'disconnected' }); },
  connectVault: async () => snapshot,
  refresh: async () => snapshot,
  refreshDwnEndpoints: async () => snapshot,
  retryRemote: async () => snapshot,
  dispose: async () => { sessionLifetime?.abort(); },
} satisfies ConnectionStore;

Object.assign(window, { __starterFixture: {
  finishSave: () => finishSave?.(),
  taskObservationCount: () => taskObservations,
  removeTasks: () => {
    for (const [id, entry] of entries) {
      if (entry.path === 'project/task') entries.delete(id);
    }
    for (const view of views) view.publish();
  },
  addProjects: (count: number) => { for (let index = 0; index < count; index++) create('project', { name: `Remote project ${index}` }); },
} });
createRoot(document.getElementById('root')!).render(
  <StrictMode><EnboxProvider application={createApplication({ stores: applicationOptions.stores, connection: () => client })}><App /></EnboxProvider></StrictMode>,
);
